---
// 全站基础布局：字体、令牌、主题、SEO、PWA
interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  /** 结构化数据（schema.org JSON-LD），可传多个对象 */
  jsonLd?: object[];
}
const {
  title = '玩具展馆 · 一个网页的玩具大集合',
  description = '喜欢一件，做一件 —— 日积月累攒下的单页玩具大集合。玄墨视觉，可装进手机。',
  keywords = [],
  jsonLd = [],
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// JSON-LD 序列化：< 转义为 \u003c，防止正文里出现 </script> 提前闭合标签
const toLd = (obj: object) => JSON.stringify(obj).replace(/</g, '\\u003c');
// 站点统计 snippet：逐字照抄 xiaowenz-content/ops/多站打点接入-agent指南.md，见指南禁止事项，不要自行"优化"
const PV_SNIPPET = `(function(){
  if (navigator.doNotTrack === '1') return;           // 尊重 DNT，必须保留
  var send = function(){
    try {
      var b = JSON.stringify({path: location.pathname, referrer: document.referrer});
      if (navigator.sendBeacon('https://core.xiaowenz.com/api/pv', b)) return;
      fetch('https://core.xiaowenz.com/api/pv', {method:'POST', body:b, keepalive:true, mode:'no-cors'});
    } catch(e) {}                                      // 静默失败，必须保留
  };
  if (document.visibilityState === 'prerender')
    addEventListener('visibilitychange', function(){ if(document.visibilityState==='visible') send(); }, {once:true});
  else send();
})();`;
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(',')} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="玩具展馆" />
    <meta property="og:image" content={new URL('icons/icon-512.png', Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('icons/icon-512.png', Astro.site).href} />
    {jsonLd.map((ld) => <script type="application/ld+json" set:html={toLd(ld)} />)}
    <meta name="theme-color" content="#f1f1ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <script is:inline>
      // 防闪烁：绘制前确定主题
      (() => {
        const saved = localStorage.getItem('opt-theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.dataset.theme = 'dark';
      })();
    </script>
  </head>
  <body>
    <slot />
    <div class="toast-box" id="toast-box"></div>
    <script>
      // PWA 注册（仅生产环境，开发时避免缓存干扰）
      if ('serviceWorker' in navigator && import.meta.env.PROD) {
        addEventListener('load', () => navigator.serviceWorker.register('/sw.js').catch(() => {}));
      }
    </script>
    <!-- 站点统计(xiaowenz 自托管 GA-lite)：内联 snippet 照抄 xiaowenz-content/ops/多站打点接入-agent指南.md。
         core 挂掉时本站必须完全不受影响;禁止改为外链 .js / 加重试 / 删 DNT 与 try-catch。 -->
    <script is:inline set:html={PV_SNIPPET}></script>
  </body>
</html>

<style is:global>
  @import '../styles/tokens.css';
</style>
