---
// 沉浸展品页专用：左下角可折叠「关于展品」浮层面板。
// 默认收起不遮挡画面；展开后可见（正文 + FAQ 同时供搜索引擎抓取）。
// 文案单一来源：src/data/tools.ts 的 tool.seo.intro / tool.seo.faq。
import { byKey } from '../data/tools';

interface Props { toolKey: string; }
const { toolKey } = Astro.props;
const tool = byKey(toolKey);
if (!tool) throw new Error(`Unknown tool: ${toolKey}`);
---
<details class="imm-about">
  <summary>ℹ 关于{tool.name}</summary>
  <div class="imm-about__body">
    {tool.seo?.intro && <p>{tool.seo.intro}</p>}
    {tool.seo?.faq?.map((f) => (
      <div class="imm-about__qa">
        <b>{f.q}</b>
        <p>{f.a}</p>
      </div>
    ))}
  </div>
</details>

<style>
  .imm-about { position: fixed; left: 14px; bottom: 14px; z-index: 90; max-width: min(92vw, 460px); font-family: system-ui, sans-serif; }
  .imm-about summary {
    list-style: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 7px 14px; font-size: 0.82rem; letter-spacing: 0.08em;
    color: rgba(241, 241, 239, 0.72);
    background: rgba(20, 18, 16, 0.62);
    border: 1px solid rgba(241, 241, 239, 0.22);
    border-radius: 999px;
    backdrop-filter: blur(8px);
    transition: color 0.15s, border-color 0.15s;
  }
  .imm-about summary::-webkit-details-marker { display: none; }
  .imm-about summary:hover { color: #f1f1ef; border-color: rgba(241, 241, 239, 0.5); }
  .imm-about__body {
    margin-top: 10px; padding: 18px 20px;
    background: rgba(20, 18, 16, 0.88);
    border: 1px solid rgba(241, 241, 239, 0.18);
    border-radius: 12px;
    backdrop-filter: blur(10px);
    color: rgba(241, 241, 239, 0.85);
    max-height: 55vh; overflow-y: auto;
  }
  .imm-about__body p { margin: 0; line-height: 1.9; font-size: 0.88rem; }
  .imm-about__qa { margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(241, 241, 239, 0.12); }
  .imm-about__qa b { display: block; font-size: 0.86rem; color: #f1f1ef; margin-bottom: 6px; font-weight: 600; }
  .imm-about__qa p { font-size: 0.84rem; opacity: 0.85; }
</style>
