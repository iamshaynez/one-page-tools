---
import ToolShell from '../../layouts/ToolShell.astro';
---
<ToolShell toolKey="snake">
  <div class="stage">
    <div class="hud row">
      <div class="hud__item">得分 <strong id="score">0</strong></div>
      <div class="hud__item muted">最高分 <strong id="best">0</strong></div>
      <div class="grow"></div>
      <button class="btn btn--ghost btn--sm" id="pause" disabled>暂停</button>
      <button class="btn btn--sm" id="restart">重开</button>
    </div>

    <div class="board-wrap card">
      <canvas id="board" width="480" height="480" aria-label="贪食蛇棋盘"></canvas>
      <div class="board-veil" id="veil">
        <p class="veil__title serif" id="veil-title">贪食蛇</p>
        <p class="muted small" id="veil-sub">方向键 / WASD / 滑动屏幕控制</p>
        <button class="btn btn--red" id="start">开始游戏</button>
      </div>
    </div>

    <div class="dpad" aria-label="方向控制">
      <button data-dir="up" aria-label="上">↑</button>
      <div>
        <button data-dir="left" aria-label="左">←</button>
        <button data-dir="down" aria-label="下">↓</button>
        <button data-dir="right" aria-label="右">→</button>
      </div>
    </div>
    <p class="muted small center">撞墙、咬到自己都会结束本局。空格键暂停。</p>
  </div>
</ToolShell>

<style>
  .stage { max-width: 520px; margin: 0 auto; }
  .hud { margin-bottom: 14px; }
  .hud__item { font-size: 0.95rem; }
  .hud__item strong { font-family: var(--font-mono); font-size: 1.2rem; margin-left: 4px; }
  .board-wrap { position: relative; overflow: hidden; }
  #board { display: block; width: 100%; height: auto; touch-action: none; }
  .board-veil {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 14px;
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(4px);
  }
  .board-veil.hidden { display: none; }
  .veil__title { font-size: 2rem; }
  .dpad { display: flex; flex-direction: column; align-items: center; gap: 8px; margin: 18px 0 10px; }
  .dpad div { display: flex; gap: 8px; }
  .dpad button {
    width: 56px; height: 48px; font-size: 1.3rem;
    background: var(--paper-raised); color: var(--ink);
    border: 1px solid var(--line); border-radius: var(--radius-m);
  }
  .dpad button:active { background: var(--ink); color: var(--paper); }
  @media (hover: hover) and (pointer: fine) { .dpad { display: none; } }
</style>

<script>
  import { createGame, steer, step, tickInterval, GRID } from '../../scripts/snake-core';
  import type { Dir } from '../../scripts/snake-core';
  import { store } from '../../scripts/ui';

  const canvas = document.getElementById('board') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const veil = document.getElementById('veil')!;
  const pauseBtn = document.getElementById('pause') as HTMLButtonElement;

  let state = createGame();
  let best = store.get<number>('opt-snake-best', 0);
  let running = false;
  let paused = false;
  let acc = 0;
  let lastTime = 0;
  let queuedDir: Dir | null = null;
  document.getElementById('best')!.textContent = String(best);

  const cell = canvas.width / GRID;

  function colors() {
    const dark = document.documentElement.dataset.theme === 'dark';
    return dark
      ? { bg: '#201d17', grid: '#2a2620', snake: '#ece7de', head: '#ce1432', food: '#e8384f' }
      : { bg: '#fafaf8', grid: '#e6e3dc', snake: '#141210', head: '#ce1432', food: '#ce1432' };
  }

  function draw() {
    const c = colors();
    ctx.fillStyle = c.bg; ctx.fillRect(0, 0, canvas.width, canvas.height);
    ctx.strokeStyle = c.grid; ctx.lineWidth = 1;
    for (let i = 1; i < GRID; i++) {
      ctx.beginPath(); ctx.moveTo(i * cell, 0); ctx.lineTo(i * cell, canvas.height); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0, i * cell); ctx.lineTo(canvas.width, i * cell); ctx.stroke();
    }
    // 食物：漆红圆点带呼吸
    const pulse = 1 + Math.sin(performance.now() / 240) * 0.12;
    ctx.fillStyle = c.food;
    ctx.beginPath();
    ctx.arc(state.food.x * cell + cell / 2, state.food.y * cell + cell / 2, (cell / 3) * pulse, 0, Math.PI * 2);
    ctx.fill();
    // 蛇
    state.snake.forEach((p, i) => {
      ctx.fillStyle = i === 0 ? c.head : c.snake;
      const pad = i === 0 ? 1 : 2;
      const r = 4;
      const x = p.x * cell + pad, y = p.y * cell + pad, s = cell - pad * 2;
      ctx.beginPath();
      ctx.roundRect(x, y, s, s, r);
      ctx.fill();
    });
    document.getElementById('score')!.textContent = String(state.score);
  }

  function gameOver() {
    running = false;
    pauseBtn.disabled = true;
    if (state.score > best) {
      best = state.score;
      store.set('opt-snake-best', best);
      document.getElementById('best')!.textContent = String(best);
    }
    document.getElementById('veil-title')!.textContent =
      state.deathReason === 'wall' ? '撞墙了' : '咬到自己了';
    document.getElementById('veil-sub')!.textContent = `本局得分 ${state.score} · 最高 ${best}`;
    (document.getElementById('start') as HTMLButtonElement).textContent = '再来一局';
    veil.classList.remove('hidden');
  }

  function loop(t: number) {
    if (!running) return;
    const dt = t - lastTime;
    lastTime = t;
    if (!paused) {
      acc += dt;
      const interval = tickInterval(state.score);
      while (acc >= interval) {
        acc -= interval;
        if (queuedDir) { state = steer(state, queuedDir); queuedDir = null; }
        state = step(state);
        if (!state.alive) { draw(); gameOver(); return; }
      }
    }
    draw();
    requestAnimationFrame(loop);
  }

  function start() {
    state = createGame();
    acc = 0; paused = false; running = true;
    pauseBtn.textContent = '暂停';
    pauseBtn.disabled = false;
    veil.classList.add('hidden');
    lastTime = performance.now();
    requestAnimationFrame(loop);
  }

  document.getElementById('start')!.addEventListener('click', start);
  document.getElementById('restart')!.addEventListener('click', start);
  pauseBtn.addEventListener('click', () => {
    if (!running) return;
    paused = !paused;
    pauseBtn.textContent = paused ? '继续' : '暂停';
  });

  const KEYMAP: Record<string, Dir> = {
    ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
    w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right',
  };
  document.addEventListener('keydown', (e) => {
    if (e.key === ' ' && running) { e.preventDefault(); pauseBtn.click(); return; }
    const dir = KEYMAP[e.key];
    if (dir) { e.preventDefault(); queuedDir = dir; }
  });
  document.querySelectorAll<HTMLButtonElement>('.dpad button').forEach(b => {
    b.addEventListener('click', () => { queuedDir = b.dataset.dir as Dir; });
  });

  // 滑动手势
  let touchStart: { x: number; y: number } | null = null;
  canvas.addEventListener('touchstart', (e) => {
    touchStart = { x: e.touches[0].clientX, y: e.touches[0].clientY };
  }, { passive: true });
  canvas.addEventListener('touchmove', (e) => {
    if (!touchStart) return;
    const dx = e.touches[0].clientX - touchStart.x;
    const dy = e.touches[0].clientY - touchStart.y;
    if (Math.abs(dx) < 24 && Math.abs(dy) < 24) return;
    queuedDir = Math.abs(dx) > Math.abs(dy) ? (dx > 0 ? 'right' : 'left') : (dy > 0 ? 'down' : 'up');
    touchStart = null;
  }, { passive: true });

  draw();
</script>
