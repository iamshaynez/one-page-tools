---
import ToolShell from '../../layouts/ToolShell.astro';
---
<ToolShell toolKey="password">
  <div class="tool-grid tool-grid--2">
    <!-- 密码 -->
    <div class="card panel">
      <h2>强密码生成</h2>
      <div class="row">
        <div class="field grow">
          <label>长度 <span id="len-label" class="mono">20</span></label>
          <input type="range" id="length" min="8" max="64" value="20" style="width:100%;" />
        </div>
        <div class="field">
          <label>数量</label>
          <input type="number" class="input" id="count" value="5" min="1" max="20" style="width:70px;" />
        </div>
      </div>
      <div class="row small" style="margin-top:12px;">
        <label><input type="checkbox" id="opt-lower" checked /> 小写</label>
        <label><input type="checkbox" id="opt-upper" checked /> 大写</label>
        <label><input type="checkbox" id="opt-digit" checked /> 数字</label>
        <label><input type="checkbox" id="opt-symbol" checked /> 符号</label>
        <label><input type="checkbox" id="opt-ambiguous" /> 易混淆字符 0O1lI</label>
      </div>
      <button class="btn btn--red" id="gen" style="margin-top:16px;">生成密码</button>
      <div id="passwords" style="margin-top:16px;"></div>
      <p class="muted small">使用 crypto.getRandomValues（密码学安全随机源）。密码只生成在你的浏览器里。</p>
    </div>

    <!-- UUID -->
    <div class="card panel">
      <h2>UUID v4</h2>
      <div class="row">
        <div class="field grow">
          <label>数量</label>
          <input type="number" class="input" id="uuid-count" value="5" min="1" max="50" />
        </div>
        <div class="field grow">
          <label>格式</label>
          <select class="select" id="uuid-format">
            <option value="std">标准（带连字符）</option>
            <option value="plain">无连字符</option>
            <option value="upper">大写</option>
            <option value="brace">花括号 {}</option>
          </select>
        </div>
      </div>
      <button class="btn btn--red" id="gen-uuid" style="margin-top:16px;">生成 UUID</button>
      <div id="uuids" style="margin-top:16px;"></div>
      <button class="btn btn--ghost btn--sm" id="copy-all-uuid" style="margin-top:10px;">复制全部</button>
      <hr style="border:none;border-top:1px solid var(--line-soft);margin:24px 0;" />
      <h2>Nano ID 风格短码</h2>
      <div class="row">
        <div class="field grow">
          <label>长度</label>
          <input type="number" class="input" id="nano-len" value="12" min="4" max="32" />
        </div>
        <button class="btn" id="gen-nano" style="margin-top:22px;">生成</button>
      </div>
      <div id="nanos" style="margin-top:14px;"></div>
    </div>
  </div>
</ToolShell>

<style is:global>
  .panel { padding: 24px; }
  .panel h2 { font-size: 1.1rem; margin-bottom: 16px; }
  .pw-row {
    display: flex; align-items: center; gap: 10px;
    padding: 9px 12px; margin-top: 8px;
    background: var(--paper-sunken); border-radius: var(--radius-m);
    font-family: var(--font-mono); font-size: 0.9rem; word-break: break-all;
    cursor: pointer;
  }
  .pw-row:hover { outline: 1px solid var(--ink-muted); }
  .pw-row .strength { flex-shrink: 0; font-size: 0.7rem; padding: 1px 8px; border-radius: 99px; }
  .strength--weak { background: var(--red-soft); color: var(--red); }
  .strength--mid { background: color-mix(in srgb, var(--gold) 18%, transparent); color: var(--gold); }
  .strength--strong { background: color-mix(in srgb, #15803d 15%, transparent); color: #15803d; }
</style>

<script>
  import { toast, escapeHTML } from '../../scripts/ui';

  // 密码学安全随机整数 [0, max)，拒绝采样消除取模偏差
  function randomInt(max: number): number {
    const limit = Math.floor(0x100000000 / max) * max;
    const arr = new Uint32Array(1);
    let v: number;
    do { crypto.getRandomValues(arr); v = arr[0]; } while (v >= limit);
    return v % max;
  }

  const SETS = {
    lower: 'abcdefghijklmnopqrstuvwxyz',
    upper: 'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
    digit: '0123456789',
    symbol: '!@#$%^&*()-_=+[]{};:,.<>?/~',
  };
  const AMBIGUOUS = new Set('0O1lI'.split(''));

  function generatePassword(): string {
    const len = Number((document.getElementById('length') as HTMLInputElement).value);
    const useAmbiguous = (document.getElementById('opt-ambiguous') as HTMLInputElement).checked;
    const pools: string[] = [];
    for (const [key, id] of [['lower', 'opt-lower'], ['upper', 'opt-upper'], ['digit', 'opt-digit'], ['symbol', 'opt-symbol']] as const) {
      if ((document.getElementById(id) as HTMLInputElement).checked) {
        let chars = SETS[key];
        if (!useAmbiguous) chars = [...chars].filter(c => !AMBIGUOUS.has(c)).join('');
        pools.push(chars);
      }
    }
    if (!pools.length) return '';
    const all = pools.join('');
    // 保证每个选中的字符集至少出现一次
    const chars: string[] = pools.map(p => p[randomInt(p.length)]);
    while (chars.length < len) chars.push(all[randomInt(all.length)]);
    // 洗牌
    for (let i = chars.length - 1; i > 0; i--) {
      const j = randomInt(i + 1);
      [chars[i], chars[j]] = [chars[j], chars[i]];
    }
    return chars.join('');
  }

  function strength(pw: string): { label: string; cls: string } {
    let variety = 0;
    if (/[a-z]/.test(pw)) variety++;
    if (/[A-Z]/.test(pw)) variety++;
    if (/\d/.test(pw)) variety++;
    if (/[^a-zA-Z0-9]/.test(pw)) variety++;
    const score = pw.length * variety;
    if (score >= 80) return { label: '强', cls: 'strength--strong' };
    if (score >= 48) return { label: '中', cls: 'strength--mid' };
    return { label: '弱', cls: 'strength--weak' };
  }

  function renderPasswords() {
    const count = Number((document.getElementById('count') as HTMLInputElement).value);
    const box = document.getElementById('passwords')!;
    box.innerHTML = '';
    for (let i = 0; i < count; i++) {
      const pw = generatePassword();
      if (!pw) { toast('请至少勾选一种字符集'); return; }
      const s = strength(pw);
      const row = document.createElement('div');
      row.className = 'pw-row';
      row.innerHTML = `<span class="grow">${escapeHTML(pw)}</span><span class="strength ${s.cls}">${s.label}</span>`;
      row.title = '点击复制';
      row.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pw);
        toast('密码已复制');
      });
      box.appendChild(row);
    }
  }

  document.getElementById('gen')!.addEventListener('click', renderPasswords);
  document.getElementById('length')!.addEventListener('input', () => {
    document.getElementById('len-label')!.textContent = (document.getElementById('length') as HTMLInputElement).value;
  });

  function renderUUIDs() {
    const count = Number((document.getElementById('uuid-count') as HTMLInputElement).value);
    const format = (document.getElementById('uuid-format') as HTMLSelectElement).value;
    const list: string[] = [];
    for (let i = 0; i < count; i++) {
      let id = crypto.randomUUID();
      if (format === 'plain') id = id.replace(/-/g, '');
      else if (format === 'upper') id = id.toUpperCase();
      else if (format === 'brace') id = `{${id}}`;
      list.push(id);
    }
    const box = document.getElementById('uuids')!;
    box.innerHTML = '';
    list.forEach(id => {
      const row = document.createElement('div');
      row.className = 'pw-row';
      row.innerHTML = `<span class="grow">${id}</span>`;
      row.title = '点击复制';
      row.addEventListener('click', async () => {
        await navigator.clipboard.writeText(id);
        toast('UUID 已复制');
      });
      box.appendChild(row);
    });
    (document.getElementById('copy-all-uuid') as HTMLButtonElement & { _list?: string[] })._list = list;
  }

  document.getElementById('gen-uuid')!.addEventListener('click', renderUUIDs);
  document.getElementById('copy-all-uuid')!.addEventListener('click', async () => {
    const btn = document.getElementById('copy-all-uuid') as HTMLButtonElement & { _list?: string[] };
    if (!btn._list?.length) { toast('先生成 UUID'); return; }
    await navigator.clipboard.writeText(btn._list.join('\n'));
    toast('全部 UUID 已复制');
  });

  document.getElementById('gen-nano')!.addEventListener('click', () => {
    const len = Number((document.getElementById('nano-len') as HTMLInputElement).value);
    const alphabet = '23456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz'; // 去易混淆
    const box = document.getElementById('nanos')!;
    box.innerHTML = '';
    for (let n = 0; n < 3; n++) {
      let id = '';
      for (let i = 0; i < len; i++) id += alphabet[randomInt(alphabet.length)];
      const row = document.createElement('div');
      row.className = 'pw-row';
      row.innerHTML = `<span class="grow">${id}</span>`;
      row.title = '点击复制';
      row.addEventListener('click', async () => {
        await navigator.clipboard.writeText(id);
        toast('短码已复制');
      });
      box.appendChild(row);
    }
  });

  renderPasswords();
  renderUUIDs();
</script>
