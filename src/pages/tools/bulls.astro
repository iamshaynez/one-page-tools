---
import ToolShell from '../../layouts/ToolShell.astro';
---
<ToolShell toolKey="bulls">
  <div class="stage">
    <div class="card panel center">
      <p class="muted small">我想好了一个 <strong>4 位不重复数字</strong>（首位不为 0）</p>
      <div class="row" style="justify-content:center;margin-top:14px;">
        <input class="input mono" id="guess" maxlength="4" inputmode="numeric" placeholder="1234"
          style="width:160px;text-align:center;font-size:1.6rem;letter-spacing:0.3em;" />
        <button class="btn btn--red" id="submit">猜</button>
      </div>
      <p class="small" id="msg" style="margin-top:10px;min-height:1.5em;"></p>
      <p class="muted small">A = 数字位置全对 · B = 数字对位置错 · 目标 4A0B</p>
    </div>

    <div class="card panel" style="margin-top:16px;">
      <div class="row" style="justify-content:space-between;">
        <h3 style="font-size:1rem;">猜测记录（<span id="count">0</span> 次）</h3>
        <button class="btn btn--ghost btn--sm" id="restart">换一局</button>
      </div>
      <table class="table" style="margin-top:10px;">
        <thead><tr><th>#</th><th>猜测</th><th>结果</th></tr></thead>
        <tbody id="history"></tbody>
      </table>
    </div>

    <!-- 数字键盘（手机友好） -->
    <div class="keypad" id="keypad">
      <button>1</button><button>2</button><button>3</button>
      <button>4</button><button>5</button><button>6</button>
      <button>7</button><button>8</button><button>9</button>
      <button data-act="clear">清</button><button>0</button><button data-act="back">⌫</button>
    </div>
  </div>
</ToolShell>

<style>
  .stage { max-width: 460px; margin: 0 auto; }
  .panel { padding: 24px; }
  #msg.win { color: var(--red); font-weight: 600; }
  .keypad { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-top: 16px; }
  .keypad button {
    padding: 14px; font-size: 1.2rem; font-family: var(--font-mono);
    background: var(--paper-raised); border: 1px solid var(--line);
    border-radius: var(--radius-m); color: var(--ink);
  }
  .keypad button:active { background: var(--ink); color: var(--paper); }
  @media (hover: hover) and (pointer: fine) { .keypad { display: none; } }
</style>

<script>
  import { generateSecret, isValidGuess, judge } from '../../scripts/bulls-core';

  const guessEl = document.getElementById('guess') as HTMLInputElement;
  const msgEl = document.getElementById('msg')!;
  let secret = generateSecret();
  let attempts = 0;
  let finished = false;

  function msg(text: string, win = false) {
    msgEl.textContent = text;
    msgEl.className = `small ${win ? 'win' : 'muted'}`;
  }

  function submit() {
    if (finished) return;
    const guess = guessEl.value.trim();
    if (!isValidGuess(guess)) { msg('请输入 4 位互不重复的数字'); return; }
    attempts++;
    const { a, b } = judge(secret, guess);
    const tbody = document.getElementById('history')!;
    const tr = document.createElement('tr');
    tr.innerHTML = `<td class="muted">${attempts}</td><td class="mono">${guess}</td>
      <td class="mono" style="color:${a === 4 ? 'var(--red)' : 'inherit'};font-weight:${a === 4 ? '700' : '400'}">${a}A${b}B</td>`;
    tbody.prepend(tr);
    document.getElementById('count')!.textContent = String(attempts);
    guessEl.value = '';
    if (a === 4) {
      finished = true;
      msg(`🎉 就是 ${secret}！你用了 ${attempts} 次猜中。`, true);
    } else {
      msg(`${a}A${b}B，继续推理`);
    }
  }

  document.getElementById('submit')!.addEventListener('click', submit);
  guessEl.addEventListener('keydown', (e) => { if (e.key === 'Enter') submit(); });
  document.getElementById('restart')!.addEventListener('click', () => {
    secret = generateSecret();
    attempts = 0; finished = false;
    document.getElementById('history')!.innerHTML = '';
    document.getElementById('count')!.textContent = '0';
    guessEl.value = '';
    msg('新的一局，开始猜吧');
  });

  document.getElementById('keypad')!.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button')!;
    const act = btn.dataset.act;
    if (act === 'clear') guessEl.value = '';
    else if (act === 'back') guessEl.value = guessEl.value.slice(0, -1);
    else if (guessEl.value.length < 4) guessEl.value += btn.textContent;
  });

  msg('新的一局，开始猜吧');
</script>
