---
import ToolShell from '../../layouts/ToolShell.astro';
---
<ToolShell toolKey="asakusa">
  <div class="stage">
    <!-- 签筒 -->
    <div class="tube-area" id="tube-area">
      <div class="tube" id="tube" aria-hidden="true">
        <div class="tube__sticks">
          <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
        </div>
        <div class="tube__body"><span>淺<br />草<br />籤</span></div>
      </div>
      <p class="muted small" style="margin-top:20px;">心中默念所求，然后摇签</p>
      <button class="btn btn--red" id="draw" style="margin-top:14px;font-size:1.05rem;padding:14px 40px;">摇 签</button>
    </div>

    <!-- 结果签 -->
    <div class="result hidden" id="result">
      <div class="fortune-card card" id="fortune-card">
        <div class="fortune-card__seal" id="f-grade">上上</div>
        <p class="fortune-card__no muted small" id="f-no"></p>
        <h2 class="fortune-card__title" id="f-title"></h2>
        <div class="fortune-card__poem serif" id="f-poem"></div>
        <div class="fortune-card__interp">
          <h3>解曰</h3>
          <p id="f-interp"></p>
          <p class="muted small" id="f-tone"></p>
        </div>
        <div class="fortune-card__foot muted small">观音灵签 · 传统签文 · 仅供娱乐</div>
      </div>
      <div class="row" style="justify-content:center;margin-top:20px;">
        <button class="btn" id="again">再求一签</button>
        <button class="btn btn--ghost" id="save">保存签卡</button>
      </div>
    </div>

    <!-- 历史 -->
    <section class="history hidden" id="history-sec">
      <h3 class="muted small">求签记录</h3>
      <div class="history__list" id="history"></div>
    </section>
  </div>
</ToolShell>

<style is:global>
  .stage { max-width: 560px; margin: 0 auto; }
  .tube-area { text-align: center; padding: 24px 0 12px; }
  .tube { display: inline-block; position: relative; }
  .tube__sticks { display: flex; gap: 5px; justify-content: center; height: 90px; align-items: flex-end; }
  .tube__sticks i {
    width: 7px; background: linear-gradient(#d9c9a8, #b8a583);
    border-radius: 3px 3px 0 0; border: 1px solid #a08d6a;
  }
  .tube__sticks i:nth-child(odd) { height: 84px; }
  .tube__sticks i:nth-child(even) { height: 72px; }
  .tube__sticks i:nth-child(3n) { height: 78px; }
  .tube__body {
    margin-top: -4px; width: 120px; height: 150px; margin-inline: auto;
    background: linear-gradient(135deg, #8c2f2f, #6e1f1f);
    border-radius: 8px 8px 16px 16px;
    display: grid; place-items: center;
    box-shadow: inset 0 4px 10px rgba(0,0,0,.35), var(--shadow-lift);
  }
  .tube__body span { font-family: var(--font-serif); color: #e8d9b0; font-size: 1.5rem; line-height: 1.5; letter-spacing: .2em; }
  .tube--shaking { animation: shake 0.12s linear infinite; }
  @keyframes shake {
    0% { transform: rotate(-4deg) translateX(-2px); }
    50% { transform: rotate(3deg) translateX(2px); }
    100% { transform: rotate(-4deg) translateX(-2px); }
  }
  .result { animation: slideUp .4s var(--ease); }
  .fortune-card { position: relative; padding: 36px 32px 20px; text-align: center; overflow: hidden; }
  .fortune-card::before {
    content: ''; position: absolute; inset: 10px;
    border: 1px solid var(--line); border-radius: 8px; pointer-events: none;
  }
  .fortune-card__seal {
    position: absolute; top: 22px; right: 22px;
    width: 52px; height: 52px; display: grid; place-items: center;
    background: var(--red); color: #fff;
    font-family: var(--font-serif); font-size: 1.1rem; font-weight: 700;
    border-radius: 6px; transform: rotate(6deg);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--red) 40%, transparent);
  }
  .fortune-card__no { letter-spacing: .3em; }
  .fortune-card__title { font-size: 1.6rem; margin: 6px 0 22px; }
  .fortune-card__poem { font-size: 1.25rem; line-height: 2.2; letter-spacing: .12em; }
  .fortune-card__interp { margin-top: 24px; padding-top: 18px; border-top: 1px dashed var(--line); text-align: left; }
  .fortune-card__interp h3 { font-size: .95rem; color: var(--red); margin-bottom: 8px; letter-spacing: .2em; }
  .fortune-card__interp p { margin: 0 0 8px; line-height: 1.9; font-size: .95rem; }
  .fortune-card__foot { margin-top: 20px; font-size: .75rem; letter-spacing: .1em; }
  .history { margin-top: 36px; }
  .history__list { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
  .history__item { font-size: .8rem; padding: 4px 12px; border: 1px solid var(--line); border-radius: 99px; color: var(--ink-muted); }
</style>

<script>
  import { FORTUNES, GRADE_TONE, drawFortune } from '../../data/fortunes';
  import { store, toast } from '../../scripts/ui';

  const tube = document.getElementById('tube')!;
  const drawBtn = document.getElementById('draw') as HTMLButtonElement;
  const result = document.getElementById('result')!;
  let drawing = false;

  interface HistoryItem { no: number; title: string; grade: string; at: string; }
  let history = store.get<HistoryItem[]>('opt-asakusa-history', []);

  function renderHistory() {
    const sec = document.getElementById('history-sec')!;
    const box = document.getElementById('history')!;
    sec.classList.toggle('hidden', history.length === 0);
    box.innerHTML = history.slice(0, 12).map(h =>
      `<span class="history__item">第${h.no}签 ${h.title} · ${h.grade}</span>`
    ).join('');
  }

  function showFortune() {
    const f = drawFortune();
    document.getElementById('f-grade')!.textContent = f.grade;
    document.getElementById('f-no')!.textContent = `第 ${f.no} 签`;
    document.getElementById('f-title')!.textContent = f.title;
    document.getElementById('f-poem')!.innerHTML = f.poem.map(l => `<div>${l}</div>`).join('');
    document.getElementById('f-interp')!.textContent = f.interp;
    document.getElementById('f-tone')!.textContent = GRADE_TONE[f.grade];
    result.classList.remove('hidden');
    history.unshift({ no: f.no, title: f.title, grade: f.grade, at: new Date().toISOString() });
    history = history.slice(0, 30);
    store.set('opt-asakusa-history', history);
    renderHistory();
    result.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  drawBtn.addEventListener('click', () => {
    if (drawing) return;
    drawing = true;
    drawBtn.disabled = true;
    tube.classList.add('tube--shaking');
    setTimeout(() => {
      tube.classList.remove('tube--shaking');
      showFortune();
      drawing = false;
      drawBtn.disabled = false;
    }, 1100);
  });

  document.getElementById('again')!.addEventListener('click', () => drawBtn.click());

  // 保存签卡：Canvas 绘制（无 html2canvas 依赖）
  document.getElementById('save')!.addEventListener('click', () => {
    const no = document.getElementById('f-no')!.textContent!;
    const title = document.getElementById('f-title')!.textContent!;
    const grade = document.getElementById('f-grade')!.textContent!;
    const poem = [...document.getElementById('f-poem')!.children].map(d => d.textContent!);
    const interp = document.getElementById('f-interp')!.textContent!;

    const W = 720, H = 1080;
    const canvas = document.createElement('canvas');
    canvas.width = W; canvas.height = H;
    const ctx = canvas.getContext('2d')!;
    ctx.fillStyle = '#f1f1ef'; ctx.fillRect(0, 0, W, H);
    ctx.strokeStyle = '#d9d5cd'; ctx.lineWidth = 2;
    ctx.strokeRect(36, 36, W - 72, H - 72);

    ctx.fillStyle = '#8a847c'; ctx.font = '22px "Noto Serif SC", serif'; ctx.textAlign = 'center';
    ctx.fillText('观 音 灵 签', W / 2, 120);
    ctx.fillStyle = '#141210'; ctx.font = '28px "Noto Serif SC", serif';
    ctx.fillText(no, W / 2, 180);
    ctx.font = 'bold 52px "Noto Serif SC", serif';
    ctx.fillText(title, W / 2, 260);

    // 印章
    ctx.save();
    ctx.translate(W - 130, 150); ctx.rotate(0.1);
    ctx.fillStyle = '#ce1432'; ctx.fillRect(-42, -42, 84, 84);
    ctx.fillStyle = '#fff'; ctx.font = 'bold 32px "Noto Serif SC", serif';
    const g = grade.split('');
    ctx.fillText(g[0], 0, -8); ctx.fillText(g[1] ?? '', 0, 30);
    ctx.restore();

    ctx.fillStyle = '#141210'; ctx.font = '38px "Noto Serif SC", serif';
    poem.forEach((line, i) => ctx.fillText(line, W / 2, 380 + i * 76));

    ctx.fillStyle = '#45403b'; ctx.font = '24px "Noto Serif SC", serif'; ctx.textAlign = 'left';
    // 简单换行
    const maxChars = 24;
    for (let i = 0; i < interp.length; i += maxChars) {
      ctx.fillText(interp.slice(i, i + maxChars), 90, 750 + (i / maxChars) * 42);
    }
    ctx.fillStyle = '#8a847c'; ctx.font = '18px "Noto Serif SC", serif'; ctx.textAlign = 'center';
    ctx.fillText('玩具展馆 · 浅草观音寺抽签 · 仅供娱乐', W / 2, H - 70);

    canvas.toBlob((blob) => {
      if (!blob) return;
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `观音灵签-${no.replace(/\s/g, '')}.png`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
      toast('签卡已保存');
    }, 'image/png');
  });

  renderHistory();
</script>
