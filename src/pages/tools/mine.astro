---
import ToolShell from '../../layouts/ToolShell.astro';
---
<ToolShell toolKey="mine">
  <div class="stage">
    <div class="row" style="margin-bottom:14px;">
      <select class="select" id="difficulty" style="width:auto;">
        <option value="easy">初级 9×9 · 10 雷</option>
        <option value="medium" selected>中级 16×16 · 40 雷</option>
        <option value="hard">高级 16×30 · 99 雷</option>
      </select>
      <div class="grow"></div>
      <button class="btn btn--sm" id="restart">新一局</button>
    </div>

    <div class="hud card">
      <div class="hud__item serif">雷 <strong id="mines-left">40</strong></div>
      <div class="hud__item serif">时 <strong id="timer">0</strong>s</div>
      <div class="hud__item muted small">最佳 <span id="best">—</span></div>
      <div class="grow"></div>
      <span class="muted small" id="hint">首击必安全</span>
    </div>

    <div class="board-scroll">
      <div id="board" class="board" role="grid" aria-label="扫雷棋盘"></div>
    </div>

    <p class="muted small center" style="margin-top:14px;">
      左键揭开 · 右键插旗 · 双击数字快速展开<br />手机：点按揭开，长按插旗
    </p>
  </div>

  <div class="overlay hidden" id="over-overlay">
    <div class="modal center">
      <h2 id="over-title">踩雷了</h2>
      <p class="muted" id="over-stats"></p>
      <div class="row" style="justify-content:center;margin-top:20px;">
        <button class="btn btn--red" id="over-restart">再来一局</button>
      </div>
    </div>
  </div>
</ToolShell>

<style is:global>
  .stage { max-width: 760px; margin: 0 auto; }
  .hud { display: flex; align-items: center; gap: 20px; padding: 12px 18px; margin-bottom: 14px; }
  .hud__item strong { font-family: var(--font-mono); }
  .board-scroll { overflow-x: auto; }
  .board { display: grid; gap: 2px; width: max-content; margin: 0 auto; user-select: none; }
  .cell {
    width: 30px; height: 30px;
    display: grid; place-items: center;
    background: var(--paper-sunken);
    border: 1px solid var(--line-soft);
    border-radius: 4px;
    font-family: var(--font-mono); font-weight: 700; font-size: 0.9rem;
    cursor: pointer; transition: background 0.1s;
  }
  .cell:hover { background: var(--line); }
  .cell--open { background: var(--paper-raised); cursor: default; border-color: transparent; }
  .cell--mine { background: var(--red); color: #fff; }
  .cell--flag { color: var(--red); }
  .cell[data-n="1"] { color: #2563eb; }
  .cell[data-n="2"] { color: #15803d; }
  .cell[data-n="3"] { color: #ce1432; }
  .cell[data-n="4"] { color: #7c3aed; }
  .cell[data-n="5"] { color: #b45309; }
  .cell[data-n="6"] { color: #0e7490; }
  .cell[data-n="7"] { color: var(--ink); }
  .cell[data-n="8"] { color: var(--ink-muted); }
  @media (max-width: 640px) { .cell { width: 26px; height: 26px; font-size: 0.8rem; } }
</style>

<script>
  import { createBoard, reveal, toggleFlag, chord, flagCount, compute3BV, DIFFICULTIES } from '../../scripts/mine-core';
  import type { Board, Difficulty } from '../../scripts/mine-core';
  import { store } from '../../scripts/ui';

  const boardEl = document.getElementById('board')!;
  const overlay = document.getElementById('over-overlay')!;
  const diffEl = document.getElementById('difficulty') as HTMLSelectElement;
  let board: Board;
  let diff: Difficulty = 'medium';
  let timer = 0;
  let timerId: ReturnType<typeof setInterval> | null = null;
  let startTime = 0;

  function bests() { return store.get<Record<string, number>>('opt-mine-best', {}); }
  function showBest() {
    const b = bests()[diff];
    document.getElementById('best')!.textContent = b ? `${b}s` : '—';
  }

  function stopTimer() { if (timerId) { clearInterval(timerId); timerId = null; } }

  function newGame() {
    stopTimer();
    timing = false;
    const d = DIFFICULTIES[diff];
    board = createBoard(d.rows, d.cols, d.mines);
    timer = 0;
    document.getElementById('timer')!.textContent = '0';
    overlay.classList.add('hidden');
    boardEl.style.gridTemplateColumns = `repeat(${d.cols}, auto)`;
    boardEl.innerHTML = '';
    board.cells.forEach((_, i) => {
      const cell = document.createElement('button');
      cell.className = 'cell';
      cell.dataset.index = String(i);
      boardEl.appendChild(cell);
    });
    updateHUD();
    showBest();
  }

  function updateHUD() {
    document.getElementById('mines-left')!.textContent = String(board.mines - flagCount(board));
  }

  function render() {
    const cells = boardEl.children;
    board.cells.forEach((c, i) => {
      const el = cells[i] as HTMLElement;
      el.className = 'cell';
      el.textContent = '';
      delete el.dataset.n;
      if (c.revealed) {
        el.classList.add('cell--open');
        if (c.mine) { el.classList.add('cell--mine'); el.textContent = '✸'; }
        else if (c.adjacent > 0) { el.textContent = String(c.adjacent); el.dataset.n = String(c.adjacent); }
      } else if (c.flagged) {
        el.classList.add('cell--flag');
        el.textContent = '⚑';
      }
    });
    updateHUD();
  }

  function finish() {
    stopTimer();
    render();
    const elapsed = Math.round((Date.now() - startTime) / 1000);
    const bv = compute3BV(board);
    document.getElementById('over-title')!.textContent = board.won ? '扫雷成功' : '踩雷了';
    let stats = `用时 ${elapsed}s · 3BV ${bv}`;
    if (board.won) {
      const b = bests();
      if (!b[diff] || elapsed < b[diff]) {
        b[diff] = elapsed;
        store.set('opt-mine-best', b);
        stats += ' · 新纪录！';
      }
      showBest();
    }
    document.getElementById('over-stats')!.textContent = stats;
    overlay.classList.remove('hidden');
  }

  function tick() {
    startTime = Date.now();
    timerId = setInterval(() => {
      timer++;
      document.getElementById('timer')!.textContent = String(timer);
    }, 1000);
  }

  let timing = false;
  function ensureTimer() {
    if (!timing) { timing = true; tick(); }
  }

  boardEl.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest('.cell') as HTMLElement | null;
    if (!el || board.over) return;
    const i = Number(el.dataset.index);
    if (e.detail === 2 && board.cells[i].revealed) { chord(board, i); render(); if (board.over) finish(); return; }
    if (!timing && !board.started) ensureTimer();
    reveal(board, i);
    render();
    if (board.over) finish();
  });

  boardEl.addEventListener('contextmenu', (e) => {
    e.preventDefault();
    if (Date.now() - lastLongPress < 600) return; // 触屏长按已处理
    const el = (e.target as HTMLElement).closest('.cell') as HTMLElement | null;
    if (!el || board.over) return;
    toggleFlag(board, Number(el.dataset.index));
    render();
  });

  // 移动端长按插旗（lastLongPress 防止 iOS 同时触发 contextmenu 造成双切换）
  let pressTimer: ReturnType<typeof setTimeout> | null = null;
  let longPressed = false;
  let lastLongPress = 0;
  boardEl.addEventListener('touchstart', (e) => {
    const el = (e.target as HTMLElement).closest('.cell') as HTMLElement | null;
    if (!el) return;
    longPressed = false;
    pressTimer = setTimeout(() => {
      longPressed = true;
      lastLongPress = Date.now();
      toggleFlag(board, Number(el.dataset.index));
      render();
      if (navigator.vibrate) navigator.vibrate(30);
    }, 450);
  }, { passive: true });
  boardEl.addEventListener('touchend', (e) => {
    if (pressTimer) clearTimeout(pressTimer);
    if (longPressed) e.preventDefault();
  });
  boardEl.addEventListener('touchmove', () => { if (pressTimer) clearTimeout(pressTimer); }, { passive: true });

  diffEl.addEventListener('change', () => {
    diff = diffEl.value as Difficulty;
    timing = false;
    newGame();
  });
  document.getElementById('restart')!.addEventListener('click', () => { timing = false; newGame(); });
  document.getElementById('over-restart')!.addEventListener('click', () => { timing = false; newGame(); });

  newGame();
</script>
