<script>
  import { ANIMAL_RULES, PLANT_RULES, POWER_INFO } from '../../scripts/forest-god-content';
  import type { AnimalSpecies, PlantSpecies, Power } from '../../scripts/forest-god-content';
  import {
    applyPower, bondCapacity, bondEntity, createWorld, deserializeWorld, environmentAt, findEntity, findMemorial,
    isUnlocked, objectiveProgress, renameBond, serializeWorld, spiritRegenRate, stepWorld, worldStats,
  } from '../../scripts/forest-god-core';
  import type { Animal, ForestEvent, Memorial, Plant, World } from '../../scripts/forest-god-core';
  import { OBJECTIVES, TRAITS } from '../../scripts/forest-god-identity';
  import type { LifeMemory, TraitId } from '../../scripts/forest-god-identity';
  import { createForestScene } from '../../scripts/forest-god-scene';
  import { createForestAudio } from '../../scripts/forest-god-audio';
  import { confirmDialog, download, promptDialog, toast } from '../../scripts/ui';

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const canvas = $('world') as HTMLCanvasElement;
  const SAVE_KEY = 'forest-god-world-v1';
  const GLOBAL_POWERS: ReadonlySet<Power> = new Set(['rain', 'sun', 'storm', 'mist', 'snow', 'aurora']);
  const LOCKABLE_POWERS = ['mist', 'snow', 'aurora'] as const;
  const pageListeners = new AbortController();
  const previewParams = new URLSearchParams(location.search);
  const freshPreview = previewParams.has('test') && previewParams.has('fresh');
  let saved: string | null = null;
  try { saved = localStorage.getItem(SAVE_KEY); } catch { /* 隐私模式 */ }
  let world = createWorld();
  let preserveRejectedSave = freshPreview;
  let loadWarning: string | null = null;
  if (saved && !freshPreview) {
    try { world = deserializeWorld(saved); }
    catch {
      // 旧存档可能仍有价值：不删除，也不让临时新世界自动覆盖它。
      preserveRejectedSave = true;
      loadWarning = '旧版森林存档未能读取，原始数据已保留。本次先进入临时森林；只有另创世界后才会重新保存。';
    }
  }
  let selectedId: number | null = null;
  let followingId: number | null = null;
  let currentPower: Power = 'inspect';
  let speed = 1;
  let paused = false;
  let lastSave = performance.now();
  let soundOn = false;
  let disposed = false;
  let saveDirty = false;
  let saveDelayTimer: number | null = null;
  let idleSaveHandle: number | null = null;
  let idleSaveNative = false;
  let veilFrame = 0;
  let veilTimer: number | null = null;
  let introTimer: number | null = null;
  const audio = createForestAudio();

  function saveWorld() {
    if (preserveRejectedSave || disposed) return;
    try {
      localStorage.setItem(SAVE_KEY, serializeWorld(world));
      saveDirty = false;
      lastSave = performance.now();
    } catch { /* 存储配额或隐私模式；保留 dirty 状态以便稍后重试 */ }
  }

  function cancelPendingSave() {
    if (saveDelayTimer !== null) { clearTimeout(saveDelayTimer); saveDelayTimer = null; }
    if (idleSaveHandle === null) return;
    if (idleSaveNative) window.cancelIdleCallback(idleSaveHandle);
    else clearTimeout(idleSaveHandle);
    idleSaveHandle = null;
  }

  function scheduleIdleSave() {
    if (preserveRejectedSave || disposed || idleSaveHandle !== null) return;
    if (typeof window.requestIdleCallback === 'function') {
      idleSaveNative = true;
      idleSaveHandle = window.requestIdleCallback(() => { idleSaveHandle = null; saveWorld(); }, { timeout: 1400 });
    } else {
      idleSaveNative = false;
      idleSaveHandle = window.setTimeout(() => { idleSaveHandle = null; saveWorld(); }, 40);
    }
  }

  function queueSave(delay = 0) {
    if (preserveRejectedSave || disposed) return;
    saveDirty = true;
    if (saveDelayTimer !== null || idleSaveHandle !== null) return;
    if (delay > 0) {
      saveDelayTimer = window.setTimeout(() => { saveDelayTimer = null; scheduleIdleSave(); }, delay);
    } else scheduleIdleSave();
  }

  function flushSave() {
    cancelPendingSave();
    if (!preserveRejectedSave) saveWorld();
  }

  const behaviorNames: Record<Animal['behavior'], string> = {
    wander:'游荡', rest:'休息', seekFood:'觅食', drink:'饮水', flee:'逃窜', hunt:'追猎', court:'求偶', follow:'跟随长辈',
    alert:'警觉', groom:'梳理', play:'嬉戏', shelter:'躲避风雨',
  };
  const weatherNames: Record<World['weather']['kind'], string> = { clear:'晴朗', rain:'降雨', storm:'雷暴', mist:'晨雾', snow:'初雪' };
  const powerHints = Object.fromEntries([
    ...Object.entries(PLANT_RULES).map(([key, rule]) => [key, `点击林地播种${rule.name} · ${rule.cost} 灵力`]),
    ...Object.entries(ANIMAL_RULES).map(([key, rule]) => [key, `点击适宜栖息地引入${rule.name} · ${rule.cost} 灵力`]),
    ...Object.entries(POWER_INFO).map(([key, info]) => [key, info.hint]),
  ]) as Record<Power, string>;

  function formatDayTime(at: number): string {
    const day = ((at % 1) + 1) % 1;
    return `第 ${Math.floor(at) + 1} 日 · ${String(Math.floor(day * 24)).padStart(2, '0')} 时`;
  }

  function livingBonds(): (Plant | Animal)[] {
    return [...world.plants, ...world.animals].filter(entity => entity.alive && entity.bond);
  }

  function emptyList(list: HTMLElement, message: string) {
    const empty = document.createElement('p');
    empty.className = 'fg-empty-list';
    empty.textContent = message;
    list.replaceChildren(empty);
  }

  function renderEvents() {
    const list = $('event-list');
    const events = world.events.slice(0, 10);
    if (!events.length) { emptyList(list, '风还没有写下第一行字。'); return; }
    const fragment = document.createDocumentFragment();
    for (const event of events) {
      const button = document.createElement('button');
      button.className = `fg-event ${event.kind}`;
      button.dataset.eventId = String(event.id);
      button.title = event.entityId !== undefined ? '前往现场并打开生命档案' : '前往事件发生的地方';
      const dot = document.createElement('i');
      const body = document.createElement('span');
      body.className = 'fg-event-text';
      body.textContent = event.text;
      const time = document.createElement('time');
      time.textContent = formatDayTime(event.at);
      body.appendChild(time);
      button.append(dot, body);
      fragment.appendChild(button);
    }
    list.replaceChildren(fragment);
  }

  function makeEntityEntry(entity: Plant | Animal | Memorial, memorial: boolean): HTMLButtonElement {
    const plant = 'kind' in entity ? entity.kind === 'plant' : 'growth' in entity;
    const rule = plant ? PLANT_RULES[entity.species as PlantSpecies] : ANIMAL_RULES[entity.species as AnimalSpecies];
    const button = document.createElement('button');
    button.className = memorial ? 'fg-memorial-entry' : 'fg-bond-entry';
    button.dataset.entityId = String(entity.id);
    button.title = memorial ? '打开纪念档案并前往长眠之地' : '选择这位神眷并前往它身边';
    const glyph = document.createElement('span');
    glyph.className = 'fg-entry-glyph';
    glyph.textContent = rule.name.slice(-1);
    const body = document.createElement('span');
    body.className = 'fg-entry-main';
    const name = document.createElement('b');
    name.textContent = entity.name;
    const details = document.createElement('span');
    details.textContent = `${rule.name} · 第 ${entity.generation} 代 · ${entity.traits.map(trait => TRAITS[trait]?.name ?? trait).join(' / ')}`;
    const time = document.createElement('time');
    time.textContent = memorial
      ? `长眠于${formatDayTime((entity as Memorial).diedAt)}`
      : `结缘于第 ${Math.floor(entity.bond?.since ?? 0) + 1} 日 · ${entity.age.toFixed(1)} 日`;
    body.append(name, details, time);
    const arrow = document.createElement('span');
    arrow.className = 'fg-entry-arrow';
    arrow.textContent = '→';
    button.append(glyph, body, arrow);
    return button;
  }

  function renderBonds() {
    const list = $('bond-list');
    const bonds = livingBonds();
    if (!bonds.length) { emptyList(list, '还没有神眷。点选生命，在档案中与它结缘。'); return; }
    const fragment = document.createDocumentFragment();
    for (const entity of bonds) fragment.appendChild(makeEntityEntry(entity, false));
    list.replaceChildren(fragment);
  }

  function renderObjectives() {
    const list = $('objective-list');
    const fragment = document.createDocumentFragment();
    for (const objective of OBJECTIVES) {
      const progress = objectiveProgress(world, objective.id);
      const complete = world.progress.completed.includes(objective.id);
      const ratio = complete ? 1 : Math.max(0, Math.min(1, progress.current / progress.target));
      const article = document.createElement('article');
      article.className = `fg-objective${complete ? ' complete' : ''}`;
      const head = document.createElement('div');
      head.className = 'fg-objective-head';
      const name = document.createElement('b');
      name.textContent = objective.name;
      const status = document.createElement('span');
      status.textContent = complete ? '已达成' : objective.id === 'ancientTree'
        ? `${Math.round(progress.current * 100)}%`
        : `${Math.min(progress.current, progress.target)} / ${progress.target}`;
      head.append(name, status);
      const description = document.createElement('p');
      description.textContent = objective.description;
      const track = document.createElement('div');
      track.className = 'fg-objective-track';
      const fill = document.createElement('i');
      fill.style.width = `${Math.round(ratio * 100)}%`;
      track.appendChild(fill);
      const reward = document.createElement('small');
      reward.textContent = `心愿回响：${objective.reward}`;
      article.append(head, description, track, reward);
      fragment.appendChild(article);
    }
    list.replaceChildren(fragment);
  }

  function renderMemorials() {
    const list = $('memorial-list');
    if (!world.memorials.length) { emptyList(list, '纪念林尚无碑叶。逝去的神眷会在这里留下完整档案。'); return; }
    const fragment = document.createDocumentFragment();
    for (const memorial of world.memorials) fragment.appendChild(makeEntityEntry(memorial, true));
    list.replaceChildren(fragment);
  }

  type ChronicleTab = 'events' | 'bonds' | 'objectives' | 'memorials';
  let chronicleTab: ChronicleTab = 'events';
  const chronicleSignatures: Record<ChronicleTab, string> = { events:'', bonds:'', objectives:'', memorials:'' };
  const chronicleFootnotes: Record<ChronicleTab, string> = {
    events:'每条小事，都曾真实发生。', bonds:'被命名的生命，仍拥有自由的命运。',
    objectives:'心愿不是命令，而是与森林共同完成的约定。', memorials:'死亡不是遗忘；名字与记忆会留在这里。',
  };

  function updateChronicle(force = false) {
    let signature = '';
    if (chronicleTab === 'events') signature = world.events.slice(0, 10).map(event => event.id).join(',');
    else if (chronicleTab === 'bonds') signature = livingBonds().map(entity => `${entity.id}:${entity.name}:${entity.bond?.since}:${entity.generation}`).join('|');
    else if (chronicleTab === 'objectives') signature = `${world.progress.completed.join(',')}|${OBJECTIVES.map(objective => objectiveProgress(world, objective.id).current).join(',')}`;
    else signature = world.memorials.map(memorial => `${memorial.id}:${memorial.name}:${memorial.diedAt}`).join('|');
    $('chronicle-foot').textContent = chronicleFootnotes[chronicleTab];
    if (!force && chronicleSignatures[chronicleTab] === signature) return;
    chronicleSignatures[chronicleTab] = signature;
    if (chronicleTab === 'events') renderEvents();
    else if (chronicleTab === 'bonds') renderBonds();
    else if (chronicleTab === 'objectives') renderObjectives();
    else renderMemorials();
  }

  function setChronicleTab(tab: ChronicleTab) {
    chronicleTab = tab;
    document.querySelectorAll<HTMLButtonElement>('[data-chronicle-tab]').forEach(button => {
      const active = button.dataset.chronicleTab === tab;
      button.classList.toggle('active', active);
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
      const panel = $(button.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !active;
    });
    updateChronicle(true);
  }

  function setMeter(id: string, value: number) {
    const element = $(id) as HTMLElement;
    element.style.width = `${Math.round(Math.max(0, Math.min(1, value)) * 100)}%`;
  }

  function renderTraits(traits: readonly TraitId[]) {
    const container = $('entity-traits');
    const fragment = document.createDocumentFragment();
    for (const trait of traits) {
      const definition = TRAITS[trait];
      if (!definition) continue;
      const item = document.createElement('span');
      item.className = 'fg-trait';
      item.title = definition.description;
      const name = document.createElement('b');
      name.textContent = definition.name;
      const description = document.createElement('small');
      description.textContent = definition.description;
      item.append(name, description);
      fragment.appendChild(item);
    }
    container.replaceChildren(fragment);
  }

  function renderRelations(id: string, ids: readonly number[], emptyText: string) {
    const container = $(id);
    if (!ids.length) {
      const empty = document.createElement('span');
      empty.textContent = emptyText;
      container.replaceChildren(empty);
      return;
    }
    const fragment = document.createDocumentFragment();
    for (const relatedId of ids.slice(0, 8)) {
      const entity = findEntity(world, relatedId);
      const memorial = entity ? null : findMemorial(world, relatedId);
      if (entity || memorial) {
        const button = document.createElement('button');
        button.dataset.relatedId = String(relatedId);
        button.textContent = `${(entity ?? memorial)!.name} · #${relatedId}`;
        button.title = '打开这位亲人的档案';
        fragment.appendChild(button);
      } else {
        const label = document.createElement('span');
        label.textContent = `#${relatedId}`;
        fragment.appendChild(label);
      }
    }
    if (ids.length > 8) {
      const more = document.createElement('span');
      more.textContent = `等 ${ids.length} 位`;
      fragment.appendChild(more);
    }
    container.replaceChildren(fragment);
  }

  function renderMemories(memories: readonly LifeMemory[]) {
    const container = $('entity-memories');
    if (!memories.length) {
      const empty = document.createElement('li');
      empty.className = 'fg-memory-empty';
      empty.textContent = '记忆尚在日积月累。';
      container.replaceChildren(empty);
      return;
    }
    const fragment = document.createDocumentFragment();
    for (const memory of memories.slice(-6).reverse()) {
      const item = document.createElement('li');
      item.className = 'fg-memory';
      const time = document.createElement('time');
      time.textContent = formatDayTime(memory.at);
      const text = document.createElement('span');
      text.textContent = memory.text;
      item.append(time, text);
      fragment.appendChild(item);
    }
    container.replaceChildren(fragment);
  }

  let inspectorSignature = '';

  function updateFollowButton() {
    const active = followingId !== null && followingId === selectedId;
    $('btn-follow').textContent = active ? '停止跟随' : '跟随观察';
    $('btn-follow').setAttribute('aria-pressed', String(active));
    $('btn-follow').title = active ? '停止让视角持续跟随这个生命' : '让视角持续跟随这个生命；拖动画面可取消';
  }

  function updateInspector() {
    const entity = findEntity(world, selectedId);
    const memorial = entity ? null : findMemorial(world, selectedId);
    const life = entity ?? memorial;
    $('empty-inspector').hidden = !!life;
    $('entity-inspector').hidden = !life;
    $('inspector').classList.toggle('has-entity', !!life);
    if (!life) { inspectorSignature = ''; followingId = null; return; }
    const plant = memorial ? memorial.kind === 'plant' : 'growth' in (entity as Plant | Animal);
    const rule = plant ? PLANT_RULES[life.species as PlantSpecies] : ANIMAL_RULES[life.species as AnimalSpecies];
    const signature = [
      life.id, life.name, life.species, entity?.alive ?? 'archive', life.traits.join(','), life.generation,
      life.parentIds.join(','), life.offspring.join(','), entity?.bond?.name ?? '', entity?.bond?.since ?? '',
      ...life.memories.slice(-6).map(memory => `${memory.at}:${memory.kind}:${memory.text}:${memory.relatedId ?? ''}`),
      memorial?.diedAt ?? '',
    ].join('|');
    if (signature !== inspectorSignature) {
      inspectorSignature = signature;
      $('entity-glyph').textContent = rule.name.slice(-1);
      $('entity-name').textContent = life.name;
      $('entity-latin').textContent = `${rule.name} · ${rule.latin}`;
      $('entity-story').textContent = memorial ? `神眷的一生已归入纪念林。${rule.description}` : rule.description;
      $('entity-generation').textContent = `第 ${life.generation} 代`;
      $('entity-archive-note').hidden = !memorial;
      if (memorial) $('entity-archive-note').textContent = `逝世于${formatDayTime(memorial.diedAt)}，享年 ${memorial.age.toFixed(1)} 日。这里保存着它离世时的名字、天性、血脉与记忆。`;
      renderTraits(life.traits);
      renderRelations('entity-parents', life.parentIds, life.generation <= 1 ? '初代生命' : '没有留下记录');
      renderRelations('entity-offspring', life.offspring, '尚无后代记录');
      renderMemories(life.memories);
    }
    $('entity-bond-badge').hidden = !(entity?.bond || memorial);
    $('entity-live-vitals').hidden = !!memorial;
    $('entity-stage').textContent = memorial ? '纪念档案' : !entity?.alive ? '正在归土' : plant
      ? (entity as Plant).growth < 0.2 ? '萌芽' : (entity as Plant).growth < 0.6 ? '生长' : (entity as Plant).growth < 0.85 ? '成熟' : '繁茂'
      : entity.age < rule.matureAt ? '幼年' : entity.age > rule.lifespan * 0.8 ? '暮年' : '成年';
    $('entity-age').textContent = memorial ? `${memorial.age.toFixed(1)} 日 · 享年` : `${life.age.toFixed(1)} 日`;
    $('entity-sex').hidden = plant || !entity;
    $('entity-sex').textContent = entity && !plant ? ((entity as Animal).sex ? '雌性' : '雄性') : '';
    if (entity) {
      setMeter('entity-health', entity.health);
      $('health-value').textContent = `${Math.round(entity.health * 100)}%`;
      $('animal-needs').hidden = plant;
      if (!plant) {
        const animal = entity as Animal;
        setMeter('entity-food', 1 - animal.hunger); setMeter('entity-water', 1 - animal.thirst); setMeter('entity-energy', animal.energy);
        $('food-value').textContent = `${Math.round((1 - animal.hunger) * 100)}%`;
        $('water-value').textContent = `${Math.round((1 - animal.thirst) * 100)}%`;
        $('energy-value').textContent = `${Math.round(animal.energy * 100)}%`;
        $('entity-behavior').textContent = entity.alive ? behaviorNames[animal.behavior] : '生命已止息';
      } else $('entity-behavior').textContent = entity.alive ? ((entity as Plant).pollinated ? '已经授粉' : '静静生长') : '养分正在回归';
    }
    const alive = entity?.alive ?? false;
    $('btn-bond').hidden = !alive || !!entity?.bond;
    $('btn-rename').hidden = !alive || !entity?.bond;
    $('btn-follow').hidden = !alive;
    $('bond-capacity').hidden = !entity;
    if (entity) {
      const count = livingBonds().length;
      const capacity = bondCapacity(world);
      $('bond-capacity').textContent = entity.bond
        ? `神眷 ${count} / ${capacity} · 结缘于第 ${Math.floor(entity.bond.since) + 1} 日`
        : `神眷 ${count} / ${capacity} · 完成「血脉新生」等心愿可扩充`;
      $('btn-bond').title = count >= capacity ? '神眷已满；点击查看如何扩充' : '为它命名并缔结神眷';
    }
    updateFollowButton();
  }

  function selectEntity(id: number | null, focus = false) {
    const entity = findEntity(world, id);
    const memorial = entity ? null : findMemorial(world, id);
    if (id !== null && !entity && !memorial) return;
    if (followingId !== null && followingId !== id) scene.follow(null);
    selectedId = id;
    scene.select(id);
    if (id === null) scene.follow(null);
    if (focus && (entity || memorial)) {
      const location = entity ?? memorial!;
      scene.focus(location.x, location.y, 1.7);
      $('chronicle').classList.remove('open');
    }
    if (id !== null) $('intro').classList.add('gone');
    updateInspector();
  }

  function updatePowerButtons() {
    for (const power of LOCKABLE_POWERS) {
      const button = document.querySelector<HTMLButtonElement>(`[data-power="${power}"]`);
      if (!button) continue;
      const info = POWER_INFO[power];
      const locked = !isUnlocked(world, power);
      const objective = OBJECTIVES.find(item => item.unlock === power);
      const key = { mist:'7', snow:'8', aurora:'9' }[power];
      button.classList.toggle('locked', locked);
      button.dataset.locked = String(locked);
      button.setAttribute('aria-disabled', String(locked));
      button.title = `${info.name} · ${info.cost} 灵力 · ${key} · ${locked ? `未解锁：${objective?.description ?? '完成对应生态心愿'}` : info.hint}`;
      const state = button.querySelector<HTMLElement>('.fg-tool-state');
      if (state) state.textContent = locked ? '锁' : String(info.cost);
    }
  }

  function updateHud(now = performance.now()) {
    const env = environmentAt(world.time);
    const stats = worldStats(world);
    const hour = Math.floor(env.day * 24), minute = Math.floor((env.day * 24 - hour) * 60);
    const year = ['一','二','三','四','五'][env.year - 1] ?? String(env.year);
    $('epoch').textContent = `第${year}年 · ${env.season}`;
    $('clock').textContent = `第 ${Math.floor(world.time % 48) + 1} 日 · ${String(hour).padStart(2,'0')}:${String(minute).padStart(2,'0')} · ${weatherNames[world.weather.kind]}`;
    $('weather-dot').className = `fg-weather-dot ${world.weather.kind}`;
    $('spirit').textContent = String(Math.floor(world.divine));
    $('spirit-regen').textContent = `+${spiritRegenRate(world).toFixed(1)}/日`;
    setMeter('spirit-fill', world.divine / 100); setMeter('health-fill', stats.health);
    $('plant-count').textContent = String(stats.plants); $('animal-count').textContent = String(stats.animals); $('species-count').textContent = String(stats.species);
    $('fire-warning').hidden = stats.fires === 0; $('fire-count').textContent = stats.fires ? `${stats.fires} 处` : '';
    updateChronicle(); updateInspector(); updatePowerButtons(); audio.update(world);
    if (now - lastSave > 7000) { lastSave = now; queueSave(); }
  }

  function announce(message: string, ok = true) {
    $('announce').textContent = message;
    toast(message, ok ? 2300 : 2600);
  }

  function lockedPowerMessage(power: Power): string {
    const objective = OBJECTIVES.find(item => item.unlock === power);
    const name = POWER_INFO[power as keyof typeof POWER_INFO]?.name ?? '这项神力';
    return objective ? `${name}尚未解锁：${objective.description} 达成「${objective.name}」后，${objective.reward}。` : `${name}尚未解锁。`;
  }

  function castPower(power: Power, x?: number, y?: number) {
    const pointerCast = x !== undefined && y !== undefined;
    const result = applyPower(world, power, x, y);
    if (!result.ok && !isUnlocked(world, power)) result.message = lockedPowerMessage(power);
    // 指针施法由 scene 宣告结果并播放效果，避免双 toast、双特效。
    if (!pointerCast) announce(result.message, result.ok);
    if (result.ok) {
      audio.chime('divine');
      queueSave();
      if (!pointerCast) scene.playCast(result);
      updateHud();
    }
    return result;
  }

  function selectPower(power: Power) {
    currentPower = power;
    scene.setPower(power);
    document.querySelectorAll<HTMLButtonElement>('[data-power]').forEach(button => {
      const active = button.dataset.power === power && !GLOBAL_POWERS.has(power);
      button.classList.toggle('active', active);
      button.setAttribute('aria-pressed', String(active));
    });
    $('power-hint').textContent = powerHints[power] ?? '观察万物，或选择一种神谕。';
    $('intro').classList.add('gone');
  }

  function handleForestEvent(event: ForestEvent) {
    if (event.kind === 'birth') audio.chime('birth');
    else if (event.kind === 'death') audio.chime('death');
    else if (event.kind === 'bond') audio.chime('bond');
    else if (event.kind === 'milestone') audio.chime('milestone');
    if ((event.kind === 'weather' && /风暴|雷暴/.test(event.text)) || (event.kind === 'divine' && /雷暴|神雷/.test(event.text))) audio.chime('thunder');
  }

  function showFatal(error: unknown) {
    paused = true;
    $('veil').hidden = true;
    $('fatal').hidden = false;
    $('fatal-message').textContent = error instanceof Error ? error.message : '浏览器无法继续绘制这片森林。';
    audio.setHidden(true);
  }

  let scene: ReturnType<typeof createForestScene>;
  try {
    scene = createForestScene(canvas, world, {
      onTick: updateHud,
      onSelect(id) { selectEntity(id); },
      onPower(x, y) { return castPower(currentPower, x, y); },
      onMessage: announce,
      onEvent: handleForestEvent,
      onFollow(id) { followingId = id; updateFollowButton(); },
      onError(error) { setPaused(true); showFatal(error); },
    });
  } catch (error) {
    showFatal(error);
    throw error;
  }

  document.querySelectorAll<HTMLButtonElement>('[data-power]').forEach(button => {
    button.addEventListener('click', () => {
      const power = button.dataset.power as Power;
      if (GLOBAL_POWERS.has(power)) castPower(power);
      else selectPower(power);
    }, { signal: pageListeners.signal });
  });

  $('chronicle').addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const tab = event.target.closest<HTMLButtonElement>('[data-chronicle-tab]');
    if (tab) { setChronicleTab(tab.dataset.chronicleTab as ChronicleTab); return; }
    const entityEntry = event.target.closest<HTMLButtonElement>('[data-entity-id]');
    if (entityEntry) { selectEntity(Number(entityEntry.dataset.entityId), true); return; }
    const eventEntry = event.target.closest<HTMLButtonElement>('[data-event-id]');
    if (!eventEntry) return;
    const forestEvent = world.events.find(item => item.id === Number(eventEntry.dataset.eventId));
    if (!forestEvent) return;
    if (forestEvent.entityId !== undefined && (findEntity(world, forestEvent.entityId) || findMemorial(world, forestEvent.entityId))) {
      selectEntity(forestEvent.entityId, true);
    } else {
      scene.focus(forestEvent.x, forestEvent.y, 1.7);
      $('chronicle').classList.remove('open');
      $('intro').classList.add('gone');
    }
  }, { signal: pageListeners.signal });

  document.querySelector('.fg-chronicle-tabs')?.addEventListener('keydown', event => {
    if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-chronicle-tab]'));
    const current = tabs.findIndex(tab => tab.dataset.chronicleTab === chronicleTab);
    const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1
      : (current + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
    event.preventDefault();
    setChronicleTab(tabs[next].dataset.chronicleTab as ChronicleTab);
    tabs[next].focus();
  }, { signal: pageListeners.signal });

  $('entity-inspector').addEventListener('click', event => {
    if (!(event.target instanceof Element)) return;
    const relation = event.target.closest<HTMLButtonElement>('[data-related-id]');
    if (relation) selectEntity(Number(relation.dataset.relatedId), true);
  }, { signal: pageListeners.signal });

  $('btn-bond').addEventListener('click', async () => {
    const entity = findEntity(world, selectedId);
    if (!entity?.alive || entity.bond) return;
    if (livingBonds().length >= bondCapacity(world)) {
      announce('当前神眷已满。完成「初见神眷」与「血脉新生」心愿，可维系更多纽带。', false);
      return;
    }
    const id = entity.id;
    const requestedName = await promptDialog(`与${entity.name}结缘`, '为它写下名字（最多 12 字）', entity.name);
    if (requestedName === null || disposed) return;
    const result = bondEntity(world, id, requestedName);
    announce(result.message, result.ok);
    if (result.ok) {
      scene.celebrateBond(id);
      queueSave();
      updateHud();
    }
  }, { signal: pageListeners.signal });

  $('btn-rename').addEventListener('click', async () => {
    const entity = findEntity(world, selectedId);
    if (!entity?.alive || !entity.bond) return;
    const id = entity.id;
    const requestedName = await promptDialog(`为${entity.bond.name}改名`, '新的名字（最多 12 字）', entity.bond.name);
    if (requestedName === null || disposed) return;
    const result = renameBond(world, id, requestedName);
    announce(result.message, result.ok);
    if (result.ok) { audio.chime('click'); queueSave(); updateHud(); }
  }, { signal: pageListeners.signal });

  function setPaused(next: boolean) {
    paused = next;
    scene.setPaused(paused);
    $('btn-pause').setAttribute('aria-pressed', String(paused));
    $('btn-pause').title = paused ? '继续时间（空格键）' : '暂停时间（空格键）';
    const label = document.createElement('span');
    label.textContent = paused ? '继续' : '暂停';
    $('btn-pause').replaceChildren(document.createTextNode(paused ? '▶ ' : 'Ⅱ '), label);
  }
  $('btn-pause').addEventListener('click', () => setPaused(!paused), { signal: pageListeners.signal });
  document.querySelectorAll<HTMLButtonElement>('[data-speed]').forEach(button => button.addEventListener('click', () => {
    speed = Number(button.dataset.speed); scene.setSpeed(speed); setPaused(false);
    document.querySelectorAll('[data-speed]').forEach(other => other.classList.toggle('active', other === button));
  }, { signal: pageListeners.signal }));
  $('zoom-in').addEventListener('click', () => scene.zoomBy(1.25), { signal: pageListeners.signal });
  $('zoom-out').addEventListener('click', () => scene.zoomBy(0.8), { signal: pageListeners.signal });
  $('zoom-reset').addEventListener('click', () => scene.resetView(), { signal: pageListeners.signal });
  $('dismiss-intro').addEventListener('click', () => $('intro').classList.add('gone'), { signal: pageListeners.signal });
  $('close-inspector').addEventListener('click', () => selectEntity(null), { signal: pageListeners.signal });
  $('btn-follow').addEventListener('click', () => {
    const entity = findEntity(world, selectedId);
    if (!entity?.alive) return;
    if (followingId === entity.id) scene.follow(null);
    else { scene.select(entity.id); scene.follow(entity.id); }
    updateFollowButton();
  }, { signal: pageListeners.signal });
  $('btn-chronicle').addEventListener('click', () => {
    $('chronicle').classList.toggle('open');
    if ($('chronicle').classList.contains('open')) updateChronicle(true);
  }, { signal: pageListeners.signal });
  $('close-chronicle').addEventListener('click', () => $('chronicle').classList.remove('open'), { signal: pageListeners.signal });

  function showHelp(show: boolean) { $('help').hidden = !show; if (show) $('close-help').focus(); }
  $('btn-help').addEventListener('click', () => showHelp(true), { signal: pageListeners.signal });
  $('close-help').addEventListener('click', () => showHelp(false), { signal: pageListeners.signal });
  $('close-help-bottom').addEventListener('click', () => showHelp(false), { signal: pageListeners.signal });
  $('help').addEventListener('click', event => { if (event.target === $('help')) showHelp(false); }, { signal: pageListeners.signal });
  $('btn-new-world').addEventListener('click', async () => {
    const confirmed = await confirmDialog('让另一枚世界种子发芽？', '当前森林会被覆盖。它的历史将只留在你保存过的留影里。', '另创世界');
    if (!confirmed || disposed) return;
    preserveRejectedSave = false;
    loadWarning = null;
    world = createWorld((Date.now() ^ Math.floor(Math.random() * 0xffffffff)) >>> 0);
    selectedId = null; followingId = null; inspectorSignature = '';
    for (const tab of Object.keys(chronicleSignatures) as ChronicleTab[]) chronicleSignatures[tab] = '';
    scene.setWorld(world);
    queueSave();
    showHelp(false); selectPower('inspect'); updateHud();
    announce('新的风、新的河流、新的生命。另一部自然史开始了。');
  }, { signal: pageListeners.signal });
  $('btn-sound').addEventListener('click', async () => {
    soundOn = await audio.toggle();
    if (disposed) return;
    $('btn-sound').setAttribute('aria-pressed', String(soundOn));
    $('btn-sound').title = soundOn ? '关闭环境声' : '开启环境音';
    announce(soundOn ? '风、雨与鸟鸣已被唤醒。' : '森林重归无声。');
  }, { signal: pageListeners.signal });
  $('btn-photo').addEventListener('click', async () => {
    const blob = await scene.snapshot();
    if (disposed) return;
    if (blob) { download(`森林之神-第${Math.floor(world.time) + 1}日.png`, blob, 'image/png'); announce('这一刻的森林，已经收进留影。'); }
    else announce('浏览器未能保存这张留影。', false);
  }, { signal: pageListeners.signal });
  $('btn-full').addEventListener('click', async () => {
    try {
      if (document.fullscreenElement) await document.exitFullscreen();
      else await document.documentElement.requestFullscreen();
    } catch { announce('这个浏览器暂不支持全屏。', false); }
  }, { signal: pageListeners.signal });

  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement | null;
    if (target && (['INPUT','TEXTAREA','SELECT'].includes(target.tagName) || target.isContentEditable)) return;
    if (event.key === 'Escape') { showHelp(false); $('chronicle').classList.remove('open'); selectPower('inspect'); return; }
    if (!$('help').hidden) return;
    if (event.code === 'Space') { event.preventDefault(); setPaused(!paused); return; }
    const powers: Record<string, Power> = { '1':'inspect', '2':'rain', '3':'sun', '4':'storm', '5':'bless', '6':'lightning', '7':'mist', '8':'snow', '9':'aurora' };
    const power = powers[event.key];
    if (power) {
      event.preventDefault();
      if (GLOBAL_POWERS.has(power)) castPower(power);
      else selectPower(power);
    }
    if (event.key === '0') scene.resetView();
    if (event.key === '+' || event.key === '=') scene.zoomBy(1.2);
    if (event.key === '-') scene.zoomBy(0.8);
  }, { signal: pageListeners.signal });

  window.addEventListener('pagehide', flushSave, { signal: pageListeners.signal });
  document.addEventListener('visibilitychange', () => {
    audio.setHidden(document.hidden);
    if (document.hidden) flushSave();
  }, { signal: pageListeners.signal });
  document.addEventListener('astro:before-swap', () => {
    if (disposed) return;
    flushSave();
    disposed = true;
    pageListeners.abort();
    scene.dispose();
    audio.dispose();
    cancelAnimationFrame(veilFrame);
    if (veilTimer !== null) clearTimeout(veilTimer);
    if (introTimer !== null) clearTimeout(introTimer);
  }, { once:true, signal:pageListeners.signal });

  audio.setHidden(document.hidden);
  updateHud();
  if (loadWarning) { $('announce').textContent = loadWarning; toast(loadWarning, 6500); }
  veilFrame = requestAnimationFrame(() => $('veil').classList.add('lit'));
  veilTimer = window.setTimeout(() => { $('veil').remove(); veilTimer = null; }, 1100);
  introTimer = window.setTimeout(() => { $('intro').classList.add('gone'); introTimer = null; }, 10000);
  // 仅测试模式暴露真实诊断与固定推进接口，不影响正常沙盒。
  if (new URLSearchParams(location.search).has('test')) {
    Object.assign(window, { __forestGod: {
      world: () => world,
      step: (n = 1) => { for (let i=0;i<n;i++) stepWorld(world); updateHud(); },
      render: () => scene.renderOnce(),
      stats: () => worldStats(world),
      selectPower,
      diagnostics: () => scene.diagnostics(),
    } });
  }
</script>
