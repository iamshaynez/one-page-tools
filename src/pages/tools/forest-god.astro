---
// 《森林之神》— 固定步长生态沙盒 + 程序化像素画布。全幅展品，不走 ToolShell。
import Base from '../../layouts/Base.astro';
---
<Base
  title="森林之神 · 玩具展馆"
  description="播种、唤雨、引入兽群。观察一方像素森林在食物网、四季、火焰与新生中，写下只属于你的自然史。"
>
  <script is:inline>document.documentElement.dataset.theme = 'dark';</script>
  <main class="forest-god" id="forest-god">
    <canvas id="world" aria-label="会自主演化的像素森林。拖动平移，滚轮缩放，点选生命查看档案。"></canvas>

    <header class="fg-topbar">
      <div class="fg-brand">
        <a class="fg-back" href="/" aria-label="返回玩具大厅">←</a>
        <span class="fg-leaf" aria-hidden="true"><i></i></span>
        <div>
          <h1>森林之神</h1>
          <p>FOREST GOD · AN EVER-CHANGING WILD</p>
        </div>
      </div>

      <div class="fg-epoch" aria-live="polite">
        <span class="fg-weather-dot" id="weather-dot"></span>
        <div><b id="epoch">第一年 · 春</b><span id="clock">第 1 日 · 08:00 · 晴朗</span></div>
      </div>

      <nav class="fg-actions" aria-label="展品操作">
        <button id="btn-chronicle" class="fg-icon fg-mobile-only" title="森林纪事">纪</button>
        <button id="btn-sound" class="fg-icon" aria-pressed="false" title="开启环境声">音</button>
        <button id="btn-photo" class="fg-icon" title="保存森林留影">影</button>
        <button id="btn-help" class="fg-icon" title="神明手册">?</button>
        <button id="btn-full" class="fg-icon fg-wide-only" title="全屏">⛶</button>
      </nav>
    </header>

    <section class="fg-vitals" aria-label="森林状态">
      <div class="fg-spirit-row"><span>灵力 <small id="spirit-regen">+0.0/日</small></span><b id="spirit">100</b></div>
      <div class="fg-spirit-track"><i id="spirit-fill"></i></div>
      <div class="fg-counts">
        <span><i class="fg-dot plant"></i><b id="plant-count">0</b> 草木</span>
        <span><i class="fg-dot animal"></i><b id="animal-count">0</b> 走兽</span>
        <span><i class="fg-dot species"></i><b id="species-count">0</b> 物种</span>
      </div>
      <div class="fg-balance"><span>生命均衡</span><div><i id="health-fill"></i></div></div>
    </section>

    <aside class="fg-chronicle" id="chronicle" aria-label="森林纪事">
      <div class="fg-panel-title"><span>森林纪事</span><small>CHRONICLE</small><button id="close-chronicle" class="fg-mobile-only" aria-label="关闭纪事">×</button></div>
      <div class="fg-chronicle-tabs" role="tablist" aria-label="森林手卷">
        <button id="tab-events" class="active" data-chronicle-tab="events" role="tab" aria-selected="true" aria-controls="panel-events">纪事</button>
        <button id="tab-bonds" data-chronicle-tab="bonds" role="tab" aria-selected="false" aria-controls="panel-bonds" tabindex="-1">神眷</button>
        <button id="tab-objectives" data-chronicle-tab="objectives" role="tab" aria-selected="false" aria-controls="panel-objectives" tabindex="-1">心愿</button>
        <button id="tab-memorials" data-chronicle-tab="memorials" role="tab" aria-selected="false" aria-controls="panel-memorials" tabindex="-1">纪念</button>
      </div>
      <div class="fg-chronicle-panels">
        <div id="panel-events" class="fg-chronicle-panel" role="tabpanel" aria-labelledby="tab-events"><div id="event-list" class="fg-events fg-chronicle-list"></div></div>
        <div id="panel-bonds" class="fg-chronicle-panel" role="tabpanel" aria-labelledby="tab-bonds" hidden><div id="bond-list" class="fg-chronicle-list"></div></div>
        <div id="panel-objectives" class="fg-chronicle-panel" role="tabpanel" aria-labelledby="tab-objectives" hidden><div id="objective-list" class="fg-chronicle-list"></div></div>
        <div id="panel-memorials" class="fg-chronicle-panel" role="tabpanel" aria-labelledby="tab-memorials" hidden><div id="memorial-list" class="fg-chronicle-list"></div></div>
      </div>
      <p class="fg-chronicle-foot" id="chronicle-foot">每条小事，都曾真实发生。</p>
    </aside>

    <aside class="fg-inspector" id="inspector" aria-label="万物档案">
      <div class="fg-panel-title"><span>万物档案</span><small>FIELD NOTES</small><button id="close-inspector" aria-label="收起档案">×</button></div>
      <div id="empty-inspector" class="fg-empty-inspector">
        <span class="fg-observe-mark" aria-hidden="true"></span>
        <p>点选一株草、一只兽，<br />阅读它此刻的命运。</p>
        <small>拖动环游 · 滚轮缩放 · 点击纪事定位</small>
      </div>
      <div id="entity-inspector" hidden>
        <div class="fg-entity-heading"><span id="entity-glyph">兔</span><div><h2 id="entity-name">野兔</h2><p id="entity-latin">Lepus silva</p></div><span id="entity-bond-badge" class="fg-bond-badge" hidden>神眷</span></div>
        <p class="fg-entity-story" id="entity-story"></p>
        <div class="fg-life-row"><span id="entity-stage">成年</span><span id="entity-age">0 日</span><span id="entity-sex"></span></div>
        <p class="fg-archive-note" id="entity-archive-note" hidden></p>
        <div id="entity-live-vitals">
          <div class="fg-meter"><label>健康 <b id="health-value"></b></label><div><i id="entity-health"></i></div></div>
          <div id="animal-needs">
            <div class="fg-meter"><label>饱食 <b id="food-value"></b></label><div><i id="entity-food"></i></div></div>
            <div class="fg-meter"><label>水分 <b id="water-value"></b></label><div><i id="entity-water"></i></div></div>
            <div class="fg-meter"><label>精力 <b id="energy-value"></b></label><div><i id="entity-energy"></i></div></div>
          </div>
          <div class="fg-behavior"><span>此刻</span><b id="entity-behavior">游荡</b></div>
        </div>
        <section class="fg-detail-section"><h3>天性</h3><div id="entity-traits" class="fg-traits"></div></section>
        <section class="fg-detail-section"><h3>血脉</h3><div class="fg-generation"><span>世代</span><b id="entity-generation"></b></div><div class="fg-relations"><span>父母</span><div id="entity-parents"></div></div><div class="fg-relations"><span>后代</span><div id="entity-offspring"></div></div></section>
        <section class="fg-detail-section"><h3>记忆 <small>最近的片段</small></h3><ol id="entity-memories" class="fg-memories"></ol></section>
        <p class="fg-bond-capacity" id="bond-capacity"></p>
        <div class="fg-entity-actions"><button id="btn-bond" class="fg-bond-action">结缘</button><button id="btn-rename" class="fg-rename-action" hidden>重命名</button></div>
        <button id="btn-follow" class="fg-follow" aria-pressed="false">跟随观察</button>
      </div>
    </aside>

    <div class="fg-fire-warning" id="fire-warning" hidden><span>!</span> 山火正在改变这片森林 <b id="fire-count"></b></div>

    <div class="fg-view-controls" aria-label="视角控制">
      <button id="zoom-out" aria-label="缩小">−</button><button id="zoom-reset" title="归位">◎</button><button id="zoom-in" aria-label="放大">+</button>
    </div>

    <footer class="fg-bottom">
      <div class="fg-time-controls">
        <button id="btn-pause" aria-pressed="false" title="空格键暂停">Ⅱ <span>暂停</span></button>
        <div class="fg-speed" aria-label="时间流速">
          <button data-speed="1" class="active">1×</button><button data-speed="4">4×</button><button data-speed="12">12×</button>
        </div>
      </div>
      <p class="fg-power-hint" id="power-hint">观察万物，或从下方选择一种神谕。</p>
      <div class="fg-tools" role="toolbar" aria-label="神谕工具栏">
        <div class="fg-tool-group">
          <span class="fg-group-name">观察</span>
          <div><button class="fg-tool active" data-power="inspect" aria-pressed="true" title="观察生命 · 1"><i>察</i><span>观察</span></button></div>
        </div>
        <div class="fg-tool-group">
          <span class="fg-group-name">天象</span>
          <div>
            <button class="fg-tool" data-power="rain" title="唤雨 · 18 灵力 · 2"><i>雨</i><span>唤雨</span></button>
            <button class="fg-tool" data-power="sun" title="晴光 · 12 灵力 · 3"><i>阳</i><span>晴光</span></button>
            <button class="fg-tool" data-power="storm" title="雷暴 · 30 灵力 · 4"><i>暴</i><span>雷暴</span></button>
            <button class="fg-tool" data-power="mist" title="晨雾 · 16 灵力 · 7"><i>雾</i><span>晨雾</span><small class="fg-tool-state">16</small></button>
            <button class="fg-tool" data-power="snow" title="初雪 · 24 灵力 · 8"><i>雪</i><span>初雪</span><small class="fg-tool-state">24</small></button>
            <button class="fg-tool" data-power="aurora" title="极光 · 32 灵力 · 9"><i>极</i><span>极光</span><small class="fg-tool-state">32</small></button>
            <button class="fg-tool" data-power="lightning" title="落雷 · 20 灵力 · 6"><i>雷</i><span>落雷</span></button>
          </div>
        </div>
        <div class="fg-tool-group">
          <span class="fg-group-name">草木</span>
          <div>
            <button class="fg-tool" data-power="grass" title="青草 · 2 灵力"><i>草</i><span>青草</span></button>
            <button class="fg-tool" data-power="flower" title="野花 · 3 灵力"><i>花</i><span>野花</span></button>
            <button class="fg-tool" data-power="berry" title="浆果丛 · 6 灵力"><i>果</i><span>浆果</span></button>
            <button class="fg-tool" data-power="oak" title="橡树 · 10 灵力"><i>橡</i><span>橡树</span></button>
            <button class="fg-tool" data-power="pine" title="松树 · 10 灵力"><i>松</i><span>松树</span></button>
            <button class="fg-tool" data-power="fern" title="蕨类 · 4 灵力"><i>蕨</i><span>蕨类</span></button>
            <button class="fg-tool" data-power="mushroom" title="蘑菇 · 4 灵力"><i>菌</i><span>蘑菇</span></button>
          </div>
        </div>
        <div class="fg-tool-group">
          <span class="fg-group-name">众生</span>
          <div>
            <button class="fg-tool" data-power="rabbit" title="野兔 · 8 灵力"><i>兔</i><span>野兔</span></button>
            <button class="fg-tool" data-power="deer" title="梅花鹿 · 14 灵力"><i>鹿</i><span>梅花鹿</span></button>
            <button class="fg-tool" data-power="fox" title="赤狐 · 14 灵力"><i>狐</i><span>赤狐</span></button>
            <button class="fg-tool" data-power="wolf" title="灰狼 · 18 灵力"><i>狼</i><span>灰狼</span></button>
            <button class="fg-tool" data-power="bee" title="野蜂 · 5 灵力"><i>蜂</i><span>野蜂</span></button>
            <button class="fg-tool" data-power="frog" title="树蛙 · 7 灵力"><i>蛙</i><span>树蛙</span></button>
          </div>
        </div>
        <div class="fg-tool-group">
          <span class="fg-group-name">神迹</span>
          <div><button class="fg-tool fg-bless" data-power="bless" title="赐福 · 25 灵力 · 5"><i>✦</i><span>赐福</span></button></div>
        </div>
      </div>
    </footer>

    <div class="fg-intro" id="intro"><span>你是这里的神。</span>但没有任何生命，只为你而存在。<button id="dismiss-intro" aria-label="知道了">×</button></div>
    <div class="fg-live" id="announce" aria-live="polite"></div>

    <div class="fg-help" id="help" hidden role="dialog" aria-modal="true" aria-labelledby="help-title">
      <section>
        <button class="fg-help-close" id="close-help" aria-label="关闭手册">×</button>
        <span class="fg-eyebrow">A SMALL GUIDE FOR A GREAT GOD</span>
        <h2 id="help-title">别只给予生命。<br />也给它自己的命运。</h2>
        <p class="fg-help-lead">每个世界由一枚种子生成。花草争夺水土，蜂为花授粉，鹿兔啃食嫩芽，狐狼追猎；遗骸化为养分，菌落又让死亡成为另一次开始。</p>
        <div class="fg-help-grid">
          <div><b>01 · 观察</b><p>拖动平移，滚轮或双指缩放。观察手点选生命；纪事、神眷与纪念条目都能前往现场，档案里的血脉也可继续追溯。</p></div>
          <div><b>02 · 神眷</b><p>在万物档案中结缘并为生命命名。神眷会留下记忆、延续血脉；逝去后可从「纪念」重读它的一生。完成心愿可增加结缘上限。</p></div>
          <div><b>03 · 心愿与天象</b><p>「心愿」记录生态目标。授粉解锁晨雾，神眷血脉延续三代解锁初雪；结缘后让十三类物种共存并迎来三次新生，可解锁极光。未解锁的神力会说明原因。</p></div>
          <div><b>04 · 天气</b><p>雨滋润土壤并灭火，晴光促进生长也加速蒸发，雷暴可能落雷。晨雾减少蒸发，初雪抑制火焰并促使动物避寒，极光会被神眷铭记。</p></div>
          <div><b>05 · 生态灵力</b><p>灵力随世界日恢复。森林越健康、物种越丰富、草木越繁盛，恢复越快；神眷与拥有「辉光」天性的神眷也会提供额外灵力。</p></div>
          <div><b>06 · 等待与后果</b><p>1× 适合凝视，12× 适合跨越世代。捕食者太多猎物便会消失；荒芜没有失败结局，草木与迁徙仍能带来另一次开始。</p></div>
        </div>
        <div class="fg-help-keys"><kbd>1</kbd>观察 <kbd>2</kbd>雨 <kbd>3</kbd>晴 <kbd>4</kbd>雷暴 <kbd>5</kbd>赐福 <kbd>6</kbd>落雷 <kbd>7</kbd>晨雾 <kbd>8</kbd>初雪 <kbd>9</kbd>极光 <kbd>Space</kbd>暂停 <kbd>0</kbd>归位</div>
        <div class="fg-help-actions"><button id="btn-new-world" class="fg-danger">另创一个世界</button><button id="close-help-bottom">继续凝视这片森林 →</button></div>
        <small class="fg-save-note">世界会自动保存在此浏览器中。另创世界将覆盖当前存档。</small>
      </section>
    </div>

    <div class="fg-veil" id="veil"><span class="fg-loading-tree">♣</span><p>风正在穿过第一片树叶…</p></div>
    <div class="fg-fatal" id="fatal" hidden><h2>这片森林暂时无法苏醒。</h2><p id="fatal-message"></p><a href="/">← 返回大厅</a></div>
  </main>
</Base>

<style is:global>
  html, body { overflow: hidden; background: #151c19 !important; }
  .forest-god { --fg-cream:#ede7d3; --fg-muted:#a7ad9d; --fg-gold:#e0c47b; --fg-line:rgba(222,225,199,.17); position:fixed; inset:0; color:var(--fg-cream); font-family:var(--font-sans); background:#151c19; isolation:isolate; }
  .forest-god *, .forest-god *::before, .forest-god *::after { box-sizing:border-box; }
  .forest-god button, .forest-god a { -webkit-tap-highlight-color:transparent; }
  .forest-god button { color:inherit; }
  .forest-god button:focus-visible, .forest-god a:focus-visible { outline:2px solid var(--fg-gold); outline-offset:3px; }
  .forest-god [hidden] { display:none !important; }
  #world { position:absolute; inset:0; width:100%; height:100%; display:block; image-rendering:pixelated; image-rendering:crisp-edges; touch-action:none; cursor:grab; }
  #world:active { cursor:grabbing; }
  .fg-topbar { position:absolute; z-index:10; top:0; left:0; right:0; padding:18px 20px; display:flex; justify-content:space-between; align-items:flex-start; pointer-events:none; background:linear-gradient(to bottom,rgba(14,19,20,.48),transparent); }
  .fg-brand { display:flex; gap:11px; align-items:center; pointer-events:auto; }
  .fg-back { color:var(--fg-cream); opacity:.65; text-decoration:none; font-size:20px; padding:4px; }
  .fg-back:hover { opacity:1; color:var(--fg-gold); }
  .fg-brand h1 { font-size:23px; letter-spacing:.22em; text-indent:.22em; color:var(--fg-cream); line-height:1.1; text-shadow:0 2px 8px #152019; }
  .fg-brand p { margin:5px 0 0; font:7px/1.2 var(--font-mono); letter-spacing:.19em; color:#c3c7b4; }
  .fg-leaf { width:24px; height:28px; position:relative; display:block; }
  .fg-leaf::before, .fg-leaf::after, .fg-leaf i { content:""; position:absolute; width:8px; height:8px; background:#9cad72; box-shadow:8px 0 #7e9461,0 8px #7e9461,8px 8px #5f7b53; }
  .fg-leaf::before { left:3px; top:1px; }
  .fg-leaf::after { left:11px; top:9px; background:#405f4c; box-shadow:-8px 0 #66805a,0 8px #3a5445; }
  .fg-leaf i { left:3px; top:25px; width:17px; height:2px; background:#c5b37b; box-shadow:none; transform:rotate(-25deg); }
  .fg-epoch { display:flex; align-items:center; gap:10px; background:rgba(22,29,26,.72); border:1px solid var(--fg-line); padding:8px 15px; backdrop-filter:blur(10px); pointer-events:auto; box-shadow:0 4px 20px rgba(13,18,17,.12); }
  .fg-epoch b { display:block; font:600 13px/1.3 var(--font-serif); letter-spacing:.14em; }
  .fg-epoch span:not(.fg-weather-dot) { display:block; color:var(--fg-muted); font:9px/1.5 var(--font-mono); margin-top:2px; }
  .fg-weather-dot { width:7px; height:7px; background:#e4c876; box-shadow:0 0 0 3px rgba(228,200,118,.1); }
  .fg-weather-dot.rain { background:#8bb7bd; box-shadow:0 0 0 3px rgba(139,183,189,.12); }
  .fg-weather-dot.storm { background:#d89684; animation:fg-pulse .7s steps(2) infinite; }
  .fg-weather-dot.mist { background:#b8c8bd; box-shadow:0 0 0 3px rgba(184,200,189,.12); }
  .fg-weather-dot.snow { background:#e5eee9; box-shadow:0 0 0 3px rgba(229,238,233,.14); }
  .fg-actions { display:flex; gap:6px; pointer-events:auto; }
  .fg-icon { width:34px; height:34px; border:1px solid var(--fg-line); background:rgba(22,29,26,.72); font:12px var(--font-mono); cursor:pointer; backdrop-filter:blur(10px); }
  .fg-icon:hover, .fg-icon[aria-pressed="true"] { border-color:#b7b98f; color:var(--fg-gold); background:rgba(43,53,42,.88); }
  .fg-vitals { position:absolute; z-index:8; left:20px; top:92px; width:218px; padding:13px 14px; background:rgba(22,29,26,.75); border:1px solid var(--fg-line); backdrop-filter:blur(10px); }
  .fg-spirit-row { display:flex; justify-content:space-between; font-size:10px; letter-spacing:.16em; color:var(--fg-muted); }
  .fg-spirit-row b { color:var(--fg-gold); font:12px var(--font-mono); }
  .fg-spirit-row small { color:#8f9f83; font:7px var(--font-mono); letter-spacing:0; margin-left:4px; }
  .fg-spirit-track { height:3px; background:#3d473e; margin:7px 0 12px; }
  .fg-spirit-track i { display:block; height:100%; width:100%; background:#d8bd76; transition:width .3s; }
  .fg-counts { display:flex; gap:10px; font-size:9px; color:var(--fg-muted); }
  .fg-counts span { white-space:nowrap; }
  .fg-counts b { color:var(--fg-cream); font:11px var(--font-mono); }
  .fg-dot { display:inline-block; width:4px; height:4px; margin:0 4px 2px 0; }
  .fg-dot.plant { background:#8fac74; } .fg-dot.animal { background:#d5ad79; } .fg-dot.species { background:#a49bbf; }
  .fg-balance { display:flex; align-items:center; gap:8px; margin-top:10px; font-size:9px; color:var(--fg-muted); }
  .fg-balance>div { flex:1; height:2px; background:#41473f; }
  .fg-balance i { display:block; height:100%; background:#9cad77; }
  .fg-chronicle, .fg-inspector { position:absolute; z-index:8; background:rgba(22,29,26,.82); border:1px solid var(--fg-line); backdrop-filter:blur(12px); box-shadow:0 10px 32px rgba(10,17,13,.14); }
  .fg-chronicle { left:20px; bottom:126px; width:255px; padding:13px 14px 9px; display:flex; flex-direction:column; max-height:clamp(190px,calc(100dvh - 320px),430px); }
  .fg-inspector { right:20px; top:91px; width:238px; padding:13px 14px 14px; display:flex; flex-direction:column; max-height:max(230px,calc(100dvh - 235px)); }
  .fg-panel-title { display:flex; align-items:baseline; gap:8px; border-bottom:1px solid var(--fg-line); padding-bottom:8px; margin-bottom:7px; }
  .fg-panel-title>span { font:600 12px var(--font-serif); letter-spacing:.16em; }
  .fg-panel-title small { color:#858f82; font:7px var(--font-mono); letter-spacing:.14em; }
  .fg-panel-title button { margin-left:auto; border:0; background:none; cursor:pointer; color:#aab09f; font-size:18px; line-height:14px; }
